  "core_notation_audit": [
    {
      "name": "Erdos91.Palomar.DilationEquivSimilar",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.DilationEquivSimilar (A B : Finset Erdos91.Palomar.Plane) : Prop :=\n  fun A B => Exists fun f => Eq (Set.image (DFunLike.coe f) (SetLike.coe A)) (SetLike.coe B)"
    },
    {
      "name": "Erdos91.Palomar.minimalDistinctDistances",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.minimalDistinctDistances.{u_1} (X : Type u_1) [MetricSpace X] (n : Nat) : Nat :=\n  fun X [MetricSpace X] n =>\n  InfSet.sInf\n    (Set.ofPred fun m =>\n      Exists fun points => And (Eq (Finset.card points) n) (Eq (Erdos91.Palomar.distinctDistances points) m))"
    },
    {
      "name": "Erdos91.Palomar.distanceSet",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.distanceSet.{u_1} {X : Type u_1} [MetricSpace X] (points : Finset X) : Finset Real :=\n  fun {X} [MetricSpace X] points =>\n  Finset.image (fun pair => Dist.dist (Prod.fst pair) (Prod.snd pair)) (Finset.offDiag points)"
    },
    {
      "name": "Erdos91.Palomar.distinctDistances",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.distinctDistances.{u_1} {X : Type u_1} [MetricSpace X] (points : Finset X) : Nat :=\n  fun {X} [MetricSpace X] points => Finset.card (Erdos91.Palomar.distanceSet points)"
    },
    {
      "name": "Erdos91.Palomar.IsOptimal",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.IsOptimal (A : Finset Erdos91.Palomar.Plane) (n : Nat) : Prop :=\n  fun A n =>\n  And (Eq (Finset.card A) n)\n    (Eq (Erdos91.Palomar.distinctDistances A) (Erdos91.Palomar.minimalDistinctDistances Erdos91.Palomar.Plane n))"
    },
    {
      "name": "Erdos91.Palomar.Plane",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.Plane : Type :=\n  EuclideanSpace Real (Fin 2)"
    },
    {
      "name": "Erdos91.Palomar.UniqueMinimizer",
      "kind": "def",
      "declaration": "def Erdos91.Palomar.UniqueMinimizer (n : Nat) : Prop :=\n  fun n =>\n  \u2200 (A B : Finset Erdos91.Palomar.Plane),\n    Erdos91.Palomar.IsOptimal A n \u2192 Erdos91.Palomar.IsOptimal B n \u2192 Erdos91.Palomar.DilationEquivSimilar A B"
    },
