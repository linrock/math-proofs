    {
      "name": "Set.Triplewise",
      "kind": "def",
      "declaration": "def Set.Triplewise.{u_1} {\u03b1 : Type u_1} (s : Set \u03b1) (r : \u03b1 \u2192 \u03b1 \u2192 \u03b1 \u2192 Prop) : Prop :=\n  fun {\u03b1} s r =>\n  \u2200 \u2983x : \u03b1\u2984,\n    Membership.mem s x \u2192\n      \u2200 \u2983y : \u03b1\u2984, Membership.mem s y \u2192 \u2200 \u2983z : \u03b1\u2984, Membership.mem s z \u2192 Ne x y \u2192 Ne y z \u2192 Ne x z \u2192 r x y z"
    },
    {
      "name": "Erdos70.Palomar.OrdinalCardinalRamsey3",
      "kind": "def",
      "declaration": "def Erdos70.Palomar.OrdinalCardinalRamsey3.{u} (\u03b1 \u03b2 : Ordinal) (c : Cardinal) : Prop :=\n  fun \u03b1 \u03b2 c =>\n  \u2200 (isRed : Ordinal.ToType \u03b1 \u2192 Ordinal.ToType \u03b1 \u2192 Ordinal.ToType \u03b1 \u2192 Prop),\n    (\u2200 (x y z : Ordinal.ToType \u03b1),\n        Ne x y \u2192 Ne y z \u2192 Ne x z \u2192 And (Iff (isRed x y z) (isRed y x z)) (Iff (isRed x y z) (isRed x z y))) \u2192\n      Or (Exists fun s => And (Eq (Ordinal.type fun x1 x2 => LT.lt x1 x2) \u03b2) (Set.Triplewise s isRed))\n        (Exists fun s => And (Eq (Cardinal.mk (Set.Elem s)) c) (Set.Triplewise s fun x y z => Not (isRed x y z)))"
    },
    {
      "name": "Erdos70.Palomar.not_ordinalCardinalRamsey3_continuum_aleph1_four",
      "kind": "theorem",
      "declaration": "theorem Erdos70.Palomar.not_ordinalCardinalRamsey3_continuum_aleph1_four :\n  Not\n    (Erdos70.Palomar.OrdinalCardinalRamsey3 (Cardinal.ord Cardinal.continuum)\n      (Cardinal.ord (DFunLike.coe Cardinal.aleph 1)) 4)"
    },
    {
      "name": "Erdos70.Palomar.erdos_70_omega_one_refuted",
      "kind": "theorem",
      "declaration": "theorem Erdos70.Palomar.erdos_70_omega_one_refuted :\n  Iff False\n    (\u2200 (n : Nat),\n      LE.le 2 n \u2192\n        Erdos70.Palomar.OrdinalCardinalRamsey3 (Cardinal.ord Cardinal.continuum)\n          (Cardinal.ord (DFunLike.coe Cardinal.aleph 1)) \u2191n)"
    },
    {
      "name": "Erdos70.Palomar.ordinalCardinalRamsey3_continuum_omega_three",
      "kind": "theorem",
      "declaration": "theorem Erdos70.Palomar.ordinalCardinalRamsey3_continuum_omega_three :\n  Erdos70.Palomar.OrdinalCardinalRamsey3 (Cardinal.ord Cardinal.continuum) Ordinal.omega0 3"
    },
    {
