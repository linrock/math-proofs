    {
      "name": "Erdos692.exactlyOneDivisorIn",
      "kind": "def",
      "declaration": "def Erdos692.exactlyOneDivisorIn (n m : Nat) : Set Nat :=\n  fun n m => Set.ofPred fun x => Eq (Set.ncard (Set.ofPred fun d => And (Membership.mem (Set.Ioo n m) d) (Dvd.dvd d x))) 1"
    },
    {
      "name": "Set.partialDensity",
      "kind": "def",
      "declaration": "def Set.partialDensity.{u_1} {\u03b2 : Type u_1} [Preorder \u03b2] [LocallyFiniteOrderBot \u03b2] (S : Set \u03b2) (A : Set \u03b2 := Set.univ)\n  (b : \u03b2) : Real :=\n  fun {\u03b2} [Preorder \u03b2] [LocallyFiniteOrderBot \u03b2] S A b =>\n  HDiv.hDiv \u2191(Set.ncard (Inter.inter (Inter.inter S A) (Set.Iio b))) \u2191(Set.ncard (Inter.inter A (Set.Iio b)))"
    },
    {
      "name": "Set.HasDensity",
      "kind": "def",
      "declaration": "def Set.HasDensity.{u_1} {\u03b2 : Type u_1} [Preorder \u03b2] [LocallyFiniteOrderBot \u03b2] (S : Set \u03b2) (\u03b1 : Real)\n  (A : Set \u03b2 := Set.univ) : Prop :=\n  fun {\u03b2} [Preorder \u03b2] [LocallyFiniteOrderBot \u03b2] S \u03b1 A =>\n  Filter.Tendsto (fun b => Set.partialDensity S A b) Filter.atTop (nhds \u03b1)"
    },
    {
      "name": "Erdos692.IsDelta\u2081",
      "kind": "def",
      "declaration": "def Erdos692.IsDelta\u2081 (n m : Nat) (\u03b4 : Real) : Prop :=\n  fun n m \u03b4 => Set.HasDensity (Erdos692.exactlyOneDivisorIn n m) \u03b4"
    },
    {
      "name": "Erdos692.erdos_692_variants_cambie_three",
      "kind": "theorem",
      "declaration": "theorem Erdos692.erdos_692_variants_cambie_three (\u03b4 : Nat \u2192 Nat \u2192 Real) :\n  (\u2200 (a b : Nat), Erdos692.IsDelta\u2081 a b (\u03b4 a b)) \u2192 And (LT.lt (\u03b4 3 7) (\u03b4 3 6)) (LT.lt (\u03b4 3 7) (\u03b4 3 8))"
    }
  ],
