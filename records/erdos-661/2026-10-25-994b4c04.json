      "kind": "theorem",
      "declaration": "theorem Erdos661.erdos_661_variants_lenz (n : Nat) :\n  Exists fun A =>\n    Exists fun B =>\n      And (Eq (Finset.card A) n)\n        (And (Eq (Finset.card B) n)\n          (And (Disjoint A B)\n            (\u2200 (x : EuclideanSpace Real (Fin 4)),\n              Membership.mem A x \u2192 \u2200 (y : EuclideanSpace Real (Fin 4)), Membership.mem B y \u2192 Eq (Dist.dist x y) 1)))"
    }
