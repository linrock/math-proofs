  "core_notation_audit": [
    {
      "name": "Erdos494.sumMultiset",
      "kind": "def",
      "declaration": "def Erdos494.sumMultiset (A : Finset Complex) (k : Nat) : Multiset Complex :=\n  fun A k => Multiset.map (fun s => Finset.sum s id) (Finset.val (Finset.powersetCard k A))"
    },
    {
      "name": "Erdos494.Erdos494Unique",
      "kind": "def",
      "declaration": "def Erdos494.Erdos494Unique (k card : Nat) : Prop :=\n  fun k card =>\n  \u2200 (A B : Finset Complex),\n    Eq (Finset.card A) card \u2192\n      Eq (Finset.card B) card \u2192 Eq (Erdos494.sumMultiset A k) (Erdos494.sumMultiset B k) \u2192 Eq A B"
    },
    {
      "name": "Erdos494.Palomar.erdos_494_variants_k_eq_2_card_not_pow_two",
      "kind": "theorem",
      "declaration": "theorem Erdos494.Palomar.erdos_494_variants_k_eq_2_card_not_pow_two (card : Nat) :\n  (\u2200 (l : Nat), Ne card (HPow.hPow 2 l)) \u2192 Erdos494.Erdos494Unique 2 card"
    },
    {
      "name": "Erdos494.Palomar.erdos_494_variants_k_eq_3_card_gt_6",
      "kind": "theorem",
      "declaration": "theorem Erdos494.Palomar.erdos_494_variants_k_eq_3_card_gt_6 (card : Nat) :\n  GT.gt card 6 \u2192 Ne card 27 \u2192 Ne card 486 \u2192 Erdos494.Erdos494Unique 3 card"
    }
  ],
