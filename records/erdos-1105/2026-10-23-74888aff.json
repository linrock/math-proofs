  "core_notation_audit": [
    {
      "name": "Erdos1105.Results.IsRainbow",
      "kind": "def",
      "declaration": "def Erdos1105.Results.IsRainbow.{u_1, u_2, u_3} {\u03b1 : Type u_1} {V : Type u_2} {K : Type u_3} {H : SimpleGraph \u03b1}\n  {G : SimpleGraph V} (f : SimpleGraph.Hom H G) (c : SimpleGraph.EdgeLabeling G K) : Prop :=\n  fun {\u03b1} {V} {K} {H} {G} f c => Function.Injective (SimpleGraph.EdgeLabeling.pullback c f)"
    },
    {
      "name": "Erdos1105.Results.antiRamseyNum",
      "kind": "def",
      "declaration": "def Erdos1105.Results.antiRamseyNum.{u_1} {\u03b1 : Type u_1} [Fintype \u03b1] (H : SimpleGraph \u03b1) (n : Nat) : Nat :=\n  fun {\u03b1} [Fintype \u03b1] H n =>\n  SupSet.sSup\n    (Set.ofPred fun k =>\n      Exists fun c =>\n        And (Function.Surjective c)\n          (\u2200 (f : SimpleGraph.Copy H Top.top), Not (Erdos1105.Results.IsRainbow (SimpleGraph.Copy.toHom f) c)))"
    },
    {
      "name": "Erdos1105.Results.erdos_1105_cycles",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.erdos_1105_cycles (k : Nat) :\n  LE.le 3 k \u2192\n    Asymptotics.IsBigO Filter.atTop\n      (fun n =>\n        HSub.hSub (\u2191(Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph k) n))\n          (HMul.hMul (HAdd.hAdd (HDiv.hDiv (HSub.hSub (\u2191k) 2) 2) (HDiv.hDiv 1 (HSub.hSub (\u2191k) 1))) \u2191n))\n      fun x => 1"
    },
    {
      "name": "Erdos1105.Results.erdos_1105_paths",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.erdos_1105_paths (k n : Nat) :\n  LE.le 5 k \u2192\n    LE.le k n \u2192\n      have \u2113 := HDiv.hDiv (HSub.hSub k 1) 2;\n      have \u03b5 := ite (Odd k) 1 2;\n      Eq (Erdos1105.Results.antiRamseyNum (SimpleGraph.pathGraph k) n)\n        (Max.max (HAdd.hAdd (Nat.choose (HSub.hSub k 2) 2) 1)\n          (HAdd.hAdd\n            (HAdd.hAdd (Nat.choose (HSub.hSub \u2113 1) 2) (HMul.hMul (HSub.hSub \u2113 1) (HAdd.hAdd (HSub.hSub n \u2113) 1))) \u03b5))"
    },
    {
      "name": "Erdos1105.Results.erdos_1105_parts_i",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.erdos_1105_parts_i (k : Nat) :\n  LE.le 3 k \u2192\n    Asymptotics.IsBigO Filter.atTop\n      (fun n =>\n        HSub.hSub (\u2191(Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph k) n))\n          (HMul.hMul (HAdd.hAdd (HDiv.hDiv (HSub.hSub (\u2191k) 2) 2) (HDiv.hDiv 1 (HSub.hSub (\u2191k) 1))) \u2191n))\n      fun x => 1"
    },
    {
      "name": "Erdos1105.Results.erdos_1105_parts_ii",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.erdos_1105_parts_ii (k n : Nat) :\n  LE.le 5 k \u2192\n    LE.le k n \u2192\n      have \u2113 := HDiv.hDiv (HSub.hSub k 1) 2;\n      have \u03b5 := ite (Odd k) 1 2;\n      Eq (Erdos1105.Results.antiRamseyNum (SimpleGraph.pathGraph k) n)\n        (Max.max (HAdd.hAdd (Nat.choose (HSub.hSub k 2) 2) 1)\n          (HAdd.hAdd\n            (HAdd.hAdd (Nat.choose (HSub.hSub \u2113 1) 2) (HMul.hMul (HSub.hSub \u2113 1) (HAdd.hAdd (HSub.hSub n \u2113) 1))) \u03b5))"
    },
    {
      "name": "Erdos1105.Results.antiRamseyNum_triangle",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.antiRamseyNum_triangle (n : Nat) (hn : LE.le 3 n) :\n  Eq (Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph 3) n) (HSub.hSub n 1)"
    },
    {
      "name": "Erdos1105.Results.cycle_fullBlock_lower",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.cycle_fullBlock_lower (k n : Nat) (hk : LE.le 3 k) (hn : LE.le k n) :\n  LE.le (HSub.hSub (HMul.hMul (HDiv.hDiv n (HSub.hSub k 1)) (HAdd.hAdd (Nat.choose (HSub.hSub k 1) 2) 1)) 1)\n    (Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph k) n)"
    },
    {
      "name": "Erdos1105.Results.cycle_real_lower",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.cycle_real_lower (k n : Nat) (hk : LE.le 3 k) (hn : LE.le k n) :\n  LE.le\n    (HSub.hSub\n      (HSub.hSub (HMul.hMul (HAdd.hAdd (HDiv.hDiv (HSub.hSub (\u2191k) 2) 2) (HDiv.hDiv 1 (HSub.hSub (\u2191k) 1))) \u2191n)\n        (HMul.hMul (HAdd.hAdd (HDiv.hDiv (HSub.hSub (\u2191k) 2) 2) (HDiv.hDiv 1 (HSub.hSub (\u2191k) 1))) \u2191(HSub.hSub k 1)))\n      1)\n    \u2191(Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph k) n)"
    },
    {
      "name": "Erdos1105.Results.cycle_linear_upper",
      "kind": "theorem",
      "declaration": "theorem Erdos1105.Results.cycle_linear_upper (k n : Nat) (hk : LE.le 3 k) (hn : LE.le k n) :\n  LE.le (\u2191(Erdos1105.Results.antiRamseyNum (SimpleGraph.cycleGraph k) n))\n    (HSub.hSub (HMul.hMul (HAdd.hAdd (HDiv.hDiv (HSub.hSub (\u2191k) 2) 2) (HDiv.hDiv 1 (HSub.hSub (\u2191k) 1))) \u2191n) 1)"
    }
  ],
