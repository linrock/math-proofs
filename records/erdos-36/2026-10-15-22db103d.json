  "core_notation_audit": [
    {
      "name": "Erdos36.Overlap",
      "kind": "def",
      "declaration": "def Erdos36.Overlap (A B : Finset Int) (k : Int) : Nat :=\n  fun A B k =>\n  Finset.card\n    (Finset.filter (fun x => Erdos36.Overlap.match_1 (fun x => Prop) x fun a b => Eq (HSub.hSub a b) k)\n      (Finset.product A B))"
    },
    {
      "name": "Erdos36.MaxOverlap",
      "kind": "def",
      "declaration": "def Erdos36.MaxOverlap (A B : Finset Int) : Nat :=\n  fun A B => iSup (Erdos36.Overlap A B)"
    },
    {
      "name": "Erdos36.M",
      "kind": "def",
      "declaration": "def Erdos36.M (n : Nat) : Nat :=\n  fun n =>\n  InfSet.sInf\n    (Set.ofPred fun x =>\n      Exists fun A =>\n        Exists fun B =>\n          Exists fun _disjoint => Exists fun _union => Exists fun _same_card => Eq (Erdos36.MaxOverlap A B) x)"
    },
    {
      "name": "Erdos36.MinOverlapQuotient",
      "kind": "def",
      "declaration": "def Erdos36.MinOverlapQuotient (N : Nat) : Real :=\n  fun N => HDiv.hDiv \u2191(Erdos36.M N) \u2191N"
    },
    {
      "name": "Erdos36.liminf_eq_limsup_minOverlapQuotient",
      "kind": "theorem",
      "declaration": "theorem Erdos36.liminf_eq_limsup_minOverlapQuotient :\n  Eq (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop) (Filter.limsup Erdos36.MinOverlapQuotient Filter.atTop)"
    },
    {
      "name": "Erdos36.tendsto_minOverlapQuotient_liminf",
      "kind": "theorem",
      "declaration": "theorem Erdos36.tendsto_minOverlapQuotient_liminf :\n  Filter.Tendsto Erdos36.MinOverlapQuotient Filter.atTop (nhds (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop))"
    },
    {
      "name": "Erdos36.minimum_overlap_variants_lower_erdos_1955",
      "kind": "theorem",
      "declaration": "theorem Erdos36.minimum_overlap_variants_lower_erdos_1955 :\n  LE.le (1 / 4) (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop)"
    },
    {
      "name": "Erdos36.minimum_overlap_variants_lower_scherk_1955",
      "kind": "theorem",
      "declaration": "theorem Erdos36.minimum_overlap_variants_lower_scherk_1955 :\n  LT.lt (HSub.hSub 1 (Inv.inv (Real.sqrt 2))) (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop)"
    },
    {
      "name": "Erdos36.minimum_overlap_variants_lower_swierczkowski_1958",
      "kind": "theorem",
      "declaration": "theorem Erdos36.minimum_overlap_variants_lower_swierczkowski_1958 :\n  LT.lt (HDiv.hDiv (HSub.hSub 4 (HPow.hPow 6 (1 / 2))) 5) (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop)"
    },
    {
      "name": "Erdos36.moser_sqrt_two_div_four_le_liminf",
      "kind": "theorem",
      "declaration": "theorem Erdos36.moser_sqrt_two_div_four_le_liminf :\n  LE.le (HDiv.hDiv (Real.sqrt 2) 4) (Filter.liminf Erdos36.MinOverlapQuotient Filter.atTop)"
    },
    {
      "name": "Erdos36.minimum_overlap_variants_upper_erdos_1955",
      "kind": "theorem",
      "declaration": "theorem Erdos36.minimum_overlap_variants_upper_erdos_1955 :\n  LE.le (Filter.limsup Erdos36.MinOverlapQuotient Filter.atTop) (1 / 2)"
    },
    {
      "name": "Erdos36.moser_scherk_combined_le_M",
      "kind": "theorem",
      "declaration": "theorem Erdos36.moser_scherk_combined_le_M (n R : Nat) :\n  LE.le\n    (HAdd.hAdd\n      (HAdd.hAdd (HMul.hMul (HMul.hMul 12 (HPow.hPow R 2)) (HPow.hPow n 2))\n        (HMul.hMul (HMul.hMul 6 (HPow.hPow R 2)) (Erdos36.M n)))\n      (HMul.hMul 6\n        (Finset.sum (Finset.range R) fun k =>\n          HMul.hMul (HSub.hSub (HPow.hPow R 2) (HPow.hPow (HAdd.hAdd k 1) 2))\n            (HSub.hSub (HMul.hMul 2 (Erdos36.M n)) (HSub.hSub (HSub.hSub (HMul.hMul 2 n) 1) k)))))\n    (HAdd.hAdd (HMul.hMul 8 (HPow.hPow n 4))\n      (HMul.hMul (HMul.hMul (HMul.hMul 4 R) (HSub.hSub (HMul.hMul 4 (HPow.hPow R 2)) 1)) (Erdos36.M n)))"
    },
    {
      "name": "Erdos36.exact_values_M",
      "kind": "theorem",
      "declaration": "theorem Erdos36.exact_values_M :\n  And (Eq (Erdos36.M 1) 1)\n    (And (Eq (Erdos36.M 2) 1)\n      (And (Eq (Erdos36.M 3) 2)\n        (And (Eq (Erdos36.M 6) 3)\n          (And (Eq (Erdos36.M 7) 3)\n            (And (Eq (Erdos36.M 8) 4)\n              (And (Eq (Erdos36.M 9) 4)\n                (And (Eq (Erdos36.M 12) 5) (And (Eq (Erdos36.M 14) 6) (Eq (Erdos36.M 15) 6)))))))))"
    }
  ],
