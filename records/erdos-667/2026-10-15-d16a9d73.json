  "core_notation_audit": [
    {
      "name": "Erdos667.LocallyDense",
      "kind": "def",
      "declaration": "def Erdos667.LocallyDense (p q : Nat) {n : Nat} (G : SimpleGraph (Fin n)) : Prop :=\n  fun p q {n} G =>\n  \u2200 (s : Finset (Fin n)),\n    Eq (Finset.card s) p \u2192 LE.le q (Set.ncard (SimpleGraph.edgeSet (SimpleGraph.induce (SetLike.coe s) G)))"
    },
    {
      "name": "Erdos667.H",
      "kind": "def",
      "declaration": "def Erdos667.H (p q n : Nat) : Nat :=\n  fun p q n =>\n  Nat.findGreatest\n    (fun m => \u2200 (G : SimpleGraph (Fin n)), Erdos667.LocallyDense p q G \u2192 Not (SimpleGraph.CliqueFree G m)) n"
    },
    {
      "name": "Erdos667.c",
      "kind": "def",
      "declaration": "def Erdos667.c (p q : Nat) : Real :=\n  fun p q => Filter.liminf (fun n => HDiv.hDiv (Real.log \u2191(Erdos667.H p q n)) (Real.log \u2191n)) Filter.atTop"
    },
    {
      "name": "Erdos667.variants.monotoneOn",
      "kind": "theorem",
      "declaration": "theorem Erdos667.variants.monotoneOn (p : Nat) :\n  MonotoneOn (Erdos667.c p) (Set.Icc 1 (HAdd.hAdd (Nat.choose (HSub.hSub p 1) 2) 1))"
    },
    {
      "name": "Erdos667.variants.endpoint",
      "kind": "theorem",
      "declaration": "theorem Erdos667.variants.endpoint (p : Nat) (hp : LE.le 2 p) : Eq (Erdos667.c p (HAdd.hAdd (Nat.choose (HSub.hSub p 1) 2) 1)) 1"
    },
    {
      "name": "Erdos667.variants.ramsey_lower_bound",
      "kind": "theorem",
      "declaration": "theorem Erdos667.variants.ramsey_lower_bound (p : Nat) (hp : LE.le 2 p) :\n  LE.le (HDiv.hDiv 1 (HSub.hSub (\u2191p) 1)) (Erdos667.c p 1)"
    },
    {
      "name": "Erdos667.variants.c_ge_inv_pred",
      "kind": "theorem",
      "declaration": "theorem Erdos667.variants.c_ge_inv_pred {p q : Nat} (hp : LE.le 2 p) (hq : LE.le 1 q) :\n  LE.le (HDiv.hDiv 1 (HSub.hSub (\u2191p) 1)) (Erdos667.c p q)"
    }
  ],
