  "core_notation_audit": [
    {
      "name": "SimpleGraph.cycleLengths",
      "kind": "def",
      "declaration": "def SimpleGraph.cycleLengths.{u_2} {V : Type u_2} (G : SimpleGraph V) : Set Nat :=\n  fun {V} G =>\n  Set.ofPred fun m =>\n    Exists fun a => Exists fun w => And (SimpleGraph.Walk.IsCycle w) (Eq (SimpleGraph.Walk.length w) m)"
    },
    {
      "name": "SimpleGraph.oddCycleLengths",
      "kind": "def",
      "declaration": "def SimpleGraph.oddCycleLengths.{u_2} {V : Type u_2} (G : SimpleGraph V) : Set Nat :=\n  fun {V} G => Set.ofPred fun m => And (Membership.mem (SimpleGraph.cycleLengths G) m) (Odd m)"
    },
    {
      "name": "Erdos58.erdos_58",
      "kind": "theorem",
      "declaration": "theorem Erdos58.erdos_58.{u_1} {V : Type u_1} (G : SimpleGraph V) (k : Nat) (hG : Set.Finite (SimpleGraph.oddCycleLengths G))\n  (hk : LE.le (Set.ncard (SimpleGraph.oddCycleLengths G)) k) :\n  And (LE.le (SimpleGraph.chromaticNumber G) (HAdd.hAdd (HMul.hMul 2 \u2191k) 2))\n    (Iff (Eq (SimpleGraph.chromaticNumber G) (HAdd.hAdd (HMul.hMul 2 \u2191k) 2))\n      (SimpleGraph.IsContained (SimpleGraph.completeGraph (Fin (HAdd.hAdd (HMul.hMul 2 k) 2))) G))"
    }
  ],
