      "declaration": "theorem Erdos501.erdos_501.variants.erdosHajnal_finite (n : Nat) (A : Real \u2192 Set Real) :\n  (\u2200 (x : Real), Bornology.IsBounded (A x)) \u2192\n    (\u2200 (x : Real),\n        LT.lt (DFunLike.coe (MeasureTheory.Measure.toOuterMeasure MeasureTheory.MeasureSpace.volume) (A x)) 1) \u2192\n      Exists fun X =>\n        And (LE.le n (Finset.card X)) (Set.Pairwise (SetLike.coe X) fun x y => Not (Membership.mem (A y) x))"
    }
