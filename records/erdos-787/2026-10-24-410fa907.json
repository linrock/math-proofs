  "core_notation_audit": [
    {
      "name": "Finset.restrictedSumset",
      "kind": "def",
      "declaration": "def Finset.restrictedSumset.{u_1} {\u03b1 : Type u_1} [Add \u03b1] [DecidableEq \u03b1] (S : Finset \u03b1) : Finset \u03b1 :=\n  fun {\u03b1} [Add \u03b1] [DecidableEq \u03b1] S => Finset.image (fun p => HAdd.hAdd (Prod.fst p) (Prod.snd p)) (Finset.offDiag S)"
    },
    {
      "name": "Erdos787.g",
      "kind": "def",
      "declaration": "def Erdos787.g.{u_1} (G : Type u_1) [Add G] [DecidableEq G] (n : Nat) : Nat :=\n  fun G [Add G] [DecidableEq G] n =>\n  SupSet.sSup\n    (Set.ofPred fun m =>\n      \u2200 (A : Finset G),\n        Eq (Finset.card A) n \u2192\n          Exists fun B => And (LE.le B A) (And (LE.le m (Finset.card B)) (Disjoint (Finset.restrictedSumset B) A)))"
    },
    {
      "name": "Erdos787.variants.klarner",
      "kind": "theorem",
      "declaration": "theorem Erdos787.variants.klarner :\n  Exists fun c =>\n    And (GT.gt c 0) (Filter.Eventually (fun n => LE.le (HMul.hMul c (Real.log \u2191n)) \u2191(Erdos787.g Real n)) Filter.atTop)"
    }
  ],
