  "core_notation_audit": [
    {
      "name": "Erdos973.Palomar.OriginalStatement",
      "kind": "def",
      "declaration": "def Erdos973.Palomar.OriginalStatement : Prop :=\n  Exists fun C =>\n  And (GT.gt C 1)\n    (\u2200 (n : Nat),\n      GE.ge n 2 \u2192\n        Exists fun z =>\n          And (Eq (z 1) 1)\n            (And (\u2200 (i : Nat), Membership.mem (Finset.Icc 1 n) i \u2192 LE.le 1 (Norm.norm (z i)))\n              (\u2200 (k : Nat),\n                Membership.mem (Finset.Icc 2 (HAdd.hAdd n 1)) k \u2192\n                  LT.lt (Norm.norm (Finset.sum (Finset.Icc 1 n) fun i => HPow.hPow (z i) k))\n                    (HPow.hPow C (Neg.neg \u2191n)))))"
    },
    {
      "name": "Erdos973.Palomar.not_erdos_973",
      "kind": "theorem",
      "declaration": "theorem Erdos973.Palomar.not_erdos_973 : Not Erdos973.Palomar.OriginalStatement"
    },
    {
      "name": "Erdos973.Palomar.eventually_exterior_power_sum_strict_lower_bound",
      "kind": "theorem",
      "declaration": "theorem Erdos973.Palomar.eventually_exterior_power_sum_strict_lower_bound (C : Real) (hC : LT.lt 1 C) :\n  Filter.Eventually\n    (fun n =>\n      \u2200 (z : Fin n \u2192 Complex),\n        (\u2200 (i : Fin n), LE.le 1 (Norm.norm (z i))) \u2192\n          Exists fun k =>\n            And (Membership.mem (Finset.Icc 2 (HAdd.hAdd n 1)) k)\n              (LT.lt (HPow.hPow C (Neg.neg \u2191n)) (Norm.norm (Finset.sum Finset.univ fun i => HPow.hPow (z i) k))))\n    Filter.atTop"
    }
  ],
