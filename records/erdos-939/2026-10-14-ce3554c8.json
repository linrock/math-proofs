  "core_notation_audit": [
    {
      "name": "Erdos939.rad",
      "kind": "def",
      "declaration": "def Erdos939.rad (n : Nat) : Nat :=\n  fun n => Finset.prod (Nat.primeFactors n) fun p => p"
    },
    {
      "name": "Erdos939.landerParkinFiveSet",
      "kind": "def",
      "declaration": "def Erdos939.landerParkinFiveSet : Finset Nat :=\n  Insert.insert (HPow.hPow 27 5)\n  (Insert.insert (HPow.hPow 84 5) (Insert.insert (HPow.hPow 110 5) (Singleton.singleton (HPow.hPow 133 5))))"
    },
    {
      "name": "Erdos939.cambieFiveSet",
      "kind": "def",
      "declaration": "def Erdos939.cambieFiveSet : Finset Nat :=\n  Insert.insert (HMul.hMul (HMul.hMul (HPow.hPow 2 8) (HPow.hPow 3 10)) (HPow.hPow 5 7))\n  (Insert.insert (HMul.hMul (HPow.hPow 2 12) (HPow.hPow 23 6))\n    (Singleton.singleton (HMul.hMul (HPow.hPow 11 5) (HPow.hPow 13 5))))"
    },
    {
      "name": "Erdos939.Erdos939GeneralSums",
      "kind": "def",
      "declaration": "def Erdos939.Erdos939GeneralSums (r k : Nat) : Set (Finset Nat) :=\n  fun r k =>\n  Set.ofPred fun S =>\n    And (Eq (Finset.card S) k)\n      (And (Finset.Coprime S)\n        (And (Nat.Full r (Finset.sum S fun s => s)) (\u2200 (s : Nat), Membership.mem S s \u2192 And (LT.lt 0 s) (Nat.Full r s))))"
    },
    {
      "name": "Nat.Full",
      "kind": "def",
      "declaration": "def Nat.Full (k n : Nat) : Prop :=\n  fun k n => \u2200 (p : Nat), Membership.mem (Nat.primeFactors n) p \u2192 Dvd.dvd (HPow.hPow p k) n"
    },
    {
      "name": "Finset.Coprime",
      "kind": "def",
      "declaration": "def Finset.Coprime (S : Finset Nat) : Prop :=\n  fun S => Eq (Finset.gcd S id) 1"
    },
    {
      "name": "Erdos939.Erdos939Sums",
      "kind": "def",
      "declaration": "def Erdos939.Erdos939Sums (r : Nat) : Set (Finset Nat) :=\n  fun r =>\n  Set.ofPred fun S =>\n    And (Eq (Finset.card S) (HSub.hSub r 2))\n      (And (Finset.Coprime S)\n        (And (Nat.Full r (Finset.sum S fun s => s)) (\u2200 (s : Nat), Membership.mem S s \u2192 And (LT.lt 0 s) (Nat.Full r s))))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_finite",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_finite : Iff False (\u2200 (r : Nat), GE.ge r 4 \u2192 Set.Finite (Erdos939.Erdos939Sums r))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_infinite_of_six_le",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_infinite_of_six_le (r : Nat) : GE.ge r 6 \u2192 Set.Infinite (Erdos939.Erdos939Sums r)"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_triples",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_triples :\n  Iff True\n    (Set.Infinite\n      (Set.ofPred fun x =>\n        Erdos939.Palomar.erdos_939_variants_triples.match_1 (fun x => Prop) x fun a b c =>\n          And (Finset.Coprime (Insert.insert a (Insert.insert b (Singleton.singleton c))))\n            (And (LT.lt 0 a)\n              (And (LT.lt 0 b) (And (Nat.Full 3 a) (And (Nat.Full 3 b) (And (Nat.Full 3 c) (Eq (HAdd.hAdd a b) c))))))))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_examples",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_examples : Exists fun r => And (GE.ge r 4) (Set.Nonempty (Erdos939.Erdos939Sums r))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_seven",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_seven : Set.Nonempty (Erdos939.Erdos939Sums 7)"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_eight",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_eight : Set.Nonempty (Erdos939.Erdos939Sums 8)"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_euler",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_euler :\n  Not\n    (\u2200 (k : Nat),\n      GE.ge k 4 \u2192\n        \u2200 (S : Finset Nat),\n          Eq (Finset.card S) (HSub.hSub k 1) \u2192\n            (\u2200 (s : Nat), Membership.mem S s \u2192 LT.lt 0 s) \u2192\n              Not (Exists fun q => Eq (Finset.sum S fun s => HPow.hPow s k) (HPow.hPow q k)))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_variants_triples_infinite",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_variants_triples_infinite :\n  Set.Infinite\n    (Set.ofPred fun x =>\n      Erdos939.Palomar.erdos_939_variants_triples_infinite.match_1 (fun x => Prop) x fun a b c =>\n        And (Finset.Coprime (Insert.insert a (Insert.insert b (Singleton.singleton c))))\n          (And (LT.lt 0 a)\n            (And (LT.lt 0 b) (And (Nat.Full 3 a) (And (Nat.Full 3 b) (And (Nat.Full 3 c) (Eq (HAdd.hAdd a b) c)))))))"
    },
    {
      "name": "Erdos939.Palomar.cohn_noncube_triples_infinite",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.cohn_noncube_triples_infinite :\n  Set.Infinite\n    (Set.ofPred fun x =>\n      Erdos939.Palomar.erdos_939_variants_triples_infinite.match_1 (fun x => Prop) x fun a b c =>\n        And (Finset.Coprime (Insert.insert a (Insert.insert b (Singleton.singleton c))))\n          (And (LT.lt 0 a)\n            (And (LT.lt 0 b)\n              (And (Nat.Full 3 a)\n                (And (Nat.Full 3 b)\n                  (And (Nat.Full 3 c)\n                    (And (\u2200 (k : Nat), Ne (HPow.hPow k 3) a)\n                      (And (\u2200 (k : Nat), Ne (HPow.hPow k 3) b)\n                        (And (\u2200 (k : Nat), Ne (HPow.hPow k 3) c) (Eq (HAdd.hAdd a b) c))))))))))"
    },
    {
      "name": "Erdos939.Palomar.cohn_noncube_generalSums_three_two_infinite",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.cohn_noncube_generalSums_three_two_infinite :\n  Set.Infinite\n    (Set.ofPred fun S =>\n      And (Membership.mem (Erdos939.Erdos939GeneralSums 3 2) S)\n        (And (\u2200 (k : Nat), Ne (HPow.hPow k 3) (Finset.sum S fun s => s))\n          (\u2200 (s : Nat), Membership.mem S s \u2192 \u2200 (k : Nat), Ne (HPow.hPow k 3) s)))"
    },
    {
      "name": "Erdos939.Palomar.erdos_939_generalSums_three_two_infinite",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_generalSums_three_two_infinite : Set.Infinite (Erdos939.Erdos939GeneralSums 3 2)"
    },
    {
      "name": "Erdos939.Palomar.cambieFiveSet_mem_erdos939Sums_five",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.cambieFiveSet_mem_erdos939Sums_five :\n  And (Membership.mem (Erdos939.Erdos939Sums 5) Erdos939.cambieFiveSet)\n    (Eq (Finset.sum Erdos939.cambieFiveSet fun s => s) (HMul.hMul (HPow.hPow 3 7) (HPow.hPow 61 5)))"
    },
    {
      "name": "Erdos939.Palomar.landerParkinFiveSet_mem_erdos939GeneralSums_five_four",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.landerParkinFiveSet_mem_erdos939GeneralSums_five_four :\n  And (Membership.mem (Erdos939.Erdos939GeneralSums 5 4) Erdos939.landerParkinFiveSet)\n    (Eq (Finset.sum Erdos939.landerParkinFiveSet fun s => s) (HPow.hPow 144 5))"
    },
    {
      "name": "Erdos939.Palomar.r_full_iff_exists_squarefree_cores",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.r_full_iff_exists_squarefree_cores (r n : Nat) (hr : LE.le 1 r) (hn : LT.lt 0 n) :\n  Iff (Nat.Full r n)\n    (Exists fun u =>\n      Exists fun v =>\n        And (\u2200 (j : Nat), Membership.mem (Finset.Ico 1 r) j \u2192 Squarefree (v j))\n          (And\n            (\u2200 (j\u2081 : Nat),\n              Membership.mem (Finset.Ico 1 r) j\u2081 \u2192\n                \u2200 (j\u2082 : Nat), Membership.mem (Finset.Ico 1 r) j\u2082 \u2192 Ne j\u2081 j\u2082 \u2192 Nat.Coprime (v j\u2081) (v j\u2082))\n            (Eq (HMul.hMul (HPow.hPow u r) (Finset.prod (Finset.Ico 1 r) fun j => HPow.hPow (v j) (HAdd.hAdd r j))) n)))"
    },
    {
      "name": "Erdos939.Palomar.rad_pow_r_lt_sum_pow_pred_of_mem_erdos939Sums",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.rad_pow_r_lt_sum_pow_pred_of_mem_erdos939Sums {r : Nat} (hr : LE.le 4 r) {S : Finset Nat}\n  (hS : Membership.mem (Erdos939.Erdos939Sums r) S) :\n  And\n    (LE.le (HPow.hPow (Erdos939.rad (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s))) r)\n      (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s)))\n    (And\n      (LT.lt (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s))\n        (HPow.hPow (Finset.sum S fun s => s) (HSub.hSub r 1)))\n      (LT.lt (HPow.hPow (Erdos939.rad (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s))) r)\n        (HPow.hPow (Finset.sum S fun s => s) (HSub.hSub r 1))))"
    },
    {
      "name": "Erdos939.Palomar.abc_quality_real_bound_of_mem_erdos939Sums",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.abc_quality_real_bound_of_mem_erdos939Sums {r : Nat} (hr : LE.le 4 r) {S : Finset Nat}\n  (hS : Membership.mem (Erdos939.Erdos939Sums r) S) :\n  LT.lt\n    (HMul.hMul (HDiv.hDiv \u2191r \u2191(HSub.hSub r 1))\n      (Real.log \u2191(Erdos939.rad (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s)))))\n    (Real.log \u2191(Finset.sum S fun s => s))"
    },
    {
      "name": "Erdos939.Palomar.rad_pow_four_le_and_lt_cube_of_mem_erdos939Sums_four",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.rad_pow_four_le_and_lt_cube_of_mem_erdos939Sums_four {a b : Nat}\n  (hmem : Membership.mem (Erdos939.Erdos939Sums 4) (Insert.insert a (Singleton.singleton b))) :\n  And\n    (Dvd.dvd (HPow.hPow (Erdos939.rad (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b))) 4)\n      (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b)))\n    (And\n      (LE.le (HPow.hPow (Erdos939.rad (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b))) 4)\n        (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b)))\n      (And (LT.lt (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b)) (HPow.hPow (HAdd.hAdd a b) 3))\n        (And\n          (LT.lt (HMul.hMul 4 (HPow.hPow (Erdos939.rad (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b))) 4))\n            (HPow.hPow (HAdd.hAdd a b) 3))\n          (LT.lt (HPow.hPow (Erdos939.rad (HMul.hMul (HMul.hMul a b) (HAdd.hAdd a b))) 4)\n            (HPow.hPow (HAdd.hAdd a b) 3)))))"
    },
    {
      "name": "Erdos939.Palomar.walsh_twist_pair_mem_erdos939GeneralSums_three_two",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.walsh_twist_pair_mem_erdos939GeneralSums_three_two {d\u2081 x\u2081 d\u2082 x\u2082 d\u2083 x\u2083 : Nat} (hd\u2081 : LT.lt 0 d\u2081)\n  (hx\u2081 : LT.lt 0 x\u2081) (hd\u2082 : LT.lt 0 d\u2082) (hx\u2082 : LT.lt 0 x\u2082) (hd\u2083 : LT.lt 0 d\u2083) (hr\u2081 : Dvd.dvd (Erdos939.rad d\u2081) x\u2081)\n  (hr\u2082 : Dvd.dvd (Erdos939.rad d\u2082) x\u2082) (hr\u2083 : Dvd.dvd (Erdos939.rad d\u2083) x\u2083)\n  (hcop : Nat.Coprime (HMul.hMul (HPow.hPow d\u2081 2) (HPow.hPow x\u2081 3)) (HMul.hMul (HPow.hPow d\u2082 2) (HPow.hPow x\u2082 3)))\n  (hsum :\n    Eq (HAdd.hAdd (HMul.hMul (HPow.hPow d\u2081 2) (HPow.hPow x\u2081 3)) (HMul.hMul (HPow.hPow d\u2082 2) (HPow.hPow x\u2082 3)))\n      (HMul.hMul (HPow.hPow d\u2083 2) (HPow.hPow x\u2083 3))) :\n  Membership.mem (Erdos939.Erdos939GeneralSums 3 2)\n    (Insert.insert (HMul.hMul (HPow.hPow d\u2081 2) (HPow.hPow x\u2081 3))\n      (Singleton.singleton (HMul.hMul (HPow.hPow d\u2082 2) (HPow.hPow x\u2082 3))))"
    },
    {
      "name": "Erdos939.Palomar.walsh_parametric_cube_scaling_coprime_iff",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.walsh_parametric_cube_scaling_coprime_iff {a b d : Nat} (hd : LT.lt 0 d) (hcop : Nat.Coprime a b) :\n  Iff (Nat.Coprime (HMul.hMul (HPow.hPow d 3) a) (HMul.hMul (HPow.hPow d 3) b)) (Eq d 1)"
    },
