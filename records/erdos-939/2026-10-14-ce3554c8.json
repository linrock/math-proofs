    {
      "name": "Erdos939.Palomar.erdos_939_iff_exists_coprime_four_full_pair",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos_939_iff_exists_coprime_four_full_pair :\n  Iff (\u2200 (r : Nat), GE.ge r 4 \u2192 Set.Nonempty (Erdos939.Erdos939Sums r))\n    (Exists fun a =>\n      Exists fun b =>\n        And (LT.lt 0 a)\n          (And (LT.lt 0 b)\n            (And (Nat.Coprime a b) (And (Nat.Full 4 a) (And (Nat.Full 4 b) (Nat.Full 4 (HAdd.hAdd a b)))))))"
    },
    {
      "name": "Erdos939.Palomar.erdos939Sums_four_finite_of_abc_seven_sixths_bound",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos939Sums_four_finite_of_abc_seven_sixths_bound {K : Nat}\n  (habc :\n    \u2200 (x y : Nat),\n      LT.lt 0 x \u2192\n        LT.lt 0 y \u2192\n          Nat.Coprime x y \u2192\n            LE.le (HPow.hPow (HAdd.hAdd x y) 6)\n              (HMul.hMul K (HPow.hPow (Erdos939.rad (HMul.hMul (HMul.hMul x y) (HAdd.hAdd x y))) 7))) :\n  Set.Finite (Erdos939.Erdos939Sums 4)"
    },
    {
      "name": "Erdos939.Palomar.erdos939Sums_five_finite_of_abc_five_fourths_threshold",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.erdos939Sums_five_finite_of_abc_five_fourths_threshold {B : Nat}\n  (habc :\n    \u2200 (S : Finset Nat),\n      Membership.mem (Erdos939.Erdos939Sums 5) S \u2192\n        LT.lt B (Finset.sum S fun s => s) \u2192\n          LE.le (HPow.hPow (Finset.sum S fun s => s) 4)\n            (HPow.hPow (Erdos939.rad (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s))) 5)) :\n  Set.Finite (Erdos939.Erdos939Sums 5)"
    },
    {
      "name": "Erdos939.Palomar.not_erdos_939_of_four_full_radical_obstruction",
      "kind": "theorem",
      "declaration": "theorem Erdos939.Palomar.not_erdos_939_of_four_full_radical_obstruction\n  (habc :\n    \u2200 (S : Finset Nat),\n      Membership.mem (Erdos939.Erdos939Sums 4) S \u2192\n        LE.le (HPow.hPow (Finset.sum S fun s => s) 3)\n          (HPow.hPow (Erdos939.rad (HMul.hMul (Finset.prod S fun s => s) (Finset.sum S fun s => s))) 4)) :\n  And (Eq (Erdos939.Erdos939Sums 4) EmptyCollection.emptyCollection)\n    (Not (\u2200 (r : Nat), GE.ge r 4 \u2192 Set.Nonempty (Erdos939.Erdos939Sums r)))"
    }
