  "core_notation_audit": [
    {
      "name": "Erdos107.Palomar.f",
      "kind": "def",
      "declaration": "def Erdos107.Palomar.f (n : Nat) : Nat :=\n  fun n => InfSet.sInf (Erdos107.Palomar.cardSet n)"
    },
    {
      "name": "EuclideanGeometry.ConvexIndep",
      "kind": "def",
      "declaration": "def EuclideanGeometry.ConvexIndep (S : Set (EuclideanSpace Real (Fin 2))) : Prop :=\n  fun S =>\n  \u2200 (a : EuclideanSpace Real (Fin 2)),\n    Membership.mem S a \u2192 Not (Membership.mem (DFunLike.coe (convexHull Real) (SDiff.sdiff S (Singleton.singleton a))) a)"
    },
    {
      "name": "EuclideanGeometry.HasConvexNGon",
      "kind": "def",
      "declaration": "def EuclideanGeometry.HasConvexNGon (n : Nat) (P : Set (EuclideanSpace Real (Fin 2))) : Prop :=\n  fun n P =>\n  Exists fun S =>\n    And (Eq (Finset.card S) n) (And (LE.le (SetLike.coe S) P) (EuclideanGeometry.ConvexIndep (SetLike.coe S)))"
    },
    {
      "name": "Set.Triplewise",
      "kind": "def",
      "declaration": "def Set.Triplewise.{u_1} {\u03b1 : Type u_1} (s : Set \u03b1) (r : \u03b1 \u2192 \u03b1 \u2192 \u03b1 \u2192 Prop) : Prop :=\n  fun {\u03b1} s r =>\n  \u2200 \u2983x : \u03b1\u2984,\n    Membership.mem s x \u2192\n      \u2200 \u2983y : \u03b1\u2984, Membership.mem s y \u2192 \u2200 \u2983z : \u03b1\u2984, Membership.mem s z \u2192 Ne x y \u2192 Ne y z \u2192 Ne x z \u2192 r x y z"
    },
    {
      "name": "EuclideanGeometry.NonTrilinear",
      "kind": "def",
      "declaration": "def EuclideanGeometry.NonTrilinear (A : Set (EuclideanSpace Real (Fin 2))) : Prop :=\n  fun A => Set.Triplewise A fun x y z => Not (Collinear Real (Insert.insert x (Insert.insert y (Singleton.singleton z))))"
    },
    {
      "name": "Erdos107.Palomar.cardSet",
      "kind": "def",
      "declaration": "def Erdos107.Palomar.cardSet (n : Nat) : Set Nat :=\n  fun n =>\n  Set.ofPred fun N =>\n    \u2200 (pts : Finset (EuclideanSpace Real (Fin 2))),\n      Eq (Finset.card pts) N \u2192\n        EuclideanGeometry.NonTrilinear (SetLike.coe pts) \u2192 EuclideanGeometry.HasConvexNGon n (SetLike.coe pts)"
    },
    {
      "name": "Erdos107.Palomar.nonempty_cardSet",
      "kind": "theorem",
      "declaration": "theorem Erdos107.Palomar.nonempty_cardSet (n : Nat) : GE.ge n 3 \u2192 Set.Nonempty (Erdos107.Palomar.cardSet n)"
    },
    {
      "name": "Erdos107.Palomar.f_le_erdosSzekeresUpper",
      "kind": "theorem",
      "declaration": "theorem Erdos107.Palomar.f_le_erdosSzekeresUpper (n : Nat) :\n  GE.ge n 3 \u2192 LE.le (Erdos107.Palomar.f n) (HAdd.hAdd (Nat.choose (HSub.hSub (HMul.hMul 2 n) 4) (HSub.hSub n 2)) 1)"
    },
    {
      "name": "Erdos107.Palomar.f_eq_conjectured_of_le_four",
      "kind": "theorem",
      "declaration": "theorem Erdos107.Palomar.f_eq_conjectured_of_le_four (n : Nat) :\n  LE.le 3 n \u2192 LE.le n 4 \u2192 Eq (Erdos107.Palomar.f n) (HAdd.hAdd (HPow.hPow 2 (HSub.hSub n 2)) 1)"
    },
    {
      "name": "Erdos107.Palomar.ersz_bounds_of_le_five",
      "kind": "theorem",
      "declaration": "theorem Erdos107.Palomar.ersz_bounds_of_le_five (n : Nat) :\n  LE.le 3 n \u2192\n    LE.le n 5 \u2192\n      And (LE.le (HAdd.hAdd (HPow.hPow 2 (HSub.hSub n 2)) 1) (Erdos107.Palomar.f n))\n        (LE.le (Erdos107.Palomar.f n) (HAdd.hAdd (Nat.choose (HSub.hSub (HMul.hMul 2 n) 4) (HSub.hSub n 2)) 1))"
    }
  ],
