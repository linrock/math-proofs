      "declaration": "def Erdos9.Erdos9A : Set Nat :=\n  Set.ofPred fun n =>\n  And (Odd n)\n    (Not\n      (Exists fun p =>\n        Exists fun k =>\n          Exists fun l => And (Nat.Prime p) (Eq n (HAdd.hAdd (HAdd.hAdd p (HPow.hPow 2 k)) (HPow.hPow 2 l)))))"
