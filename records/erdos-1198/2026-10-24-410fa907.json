      "declaration": "theorem Erdos1198.erdos_1198.variants.hindman (c : Nat \u2192 Fin 2) :\n  Exists fun a =>\n    And (StrictMono a)\n      (And (LT.lt 0 (a 0))\n        (Exists fun col => \u2200 (T : Finset Nat), Finset.Nonempty T \u2192 Eq (c (Finset.sum T fun i => a i)) col))"
