  "core_notation_audit": [
    {
      "name": "Erdos962.Erdos962Prop",
      "kind": "def",
      "declaration": "def Erdos962.Erdos962Prop (n k : Nat) : Prop :=\n  fun n k =>\n  Exists fun m =>\n    And (LE.le m n)\n      (\u2200 (i : Nat),\n        Membership.mem (Set.Icc 1 k) i \u2192\n          Exists fun p => And (Nat.Prime p) (And (LT.lt k p) (Dvd.dvd p (HAdd.hAdd m i))))"
    },
    {
      "name": "Erdos962.k",
      "kind": "def",
      "declaration": "def Erdos962.k (n : Nat) : Nat :=\n  fun n => Nat.findGreatest (fun k => Erdos962.Erdos962Prop n k) n"
    },
    {
      "name": "Erdos962.erdos_962_variants_tao_upper_bound",
      "kind": "theorem",
      "declaration": "theorem Erdos962.erdos_962_variants_tao_upper_bound :\n  Exists fun \u03b5 =>\n    And (\u2200 (\u03b4 : Real), GT.gt \u03b4 0 \u2192 Filter.Eventually (fun n => LT.lt (abs (\u03b5 n)) \u03b4) Filter.atTop)\n      (Filter.Eventually (fun n => LE.le (\u2191(Erdos962.k n)) (HMul.hMul (HAdd.hAdd 1 (\u03b5 n)) (Real.sqrt \u2191n))) Filter.atTop)"
    }
  ],
