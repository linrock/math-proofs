  "core_notation_audit": [
    {
      "name": "Erdos1139.Palomar.FixedParameterCoreDeficientType",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.FixedParameterCoreDeficientType (y z h : Nat) : Prop :=\n  fun y z h =>\n  Or (Eq h 1)\n    (Or (Nat.Prime h)\n      (Or\n        (Exists fun p =>\n          Exists fun q =>\n            And (Nat.Prime p)\n              (And (Nat.Prime q) (And (LT.lt p z) (And (LT.lt (HDiv.hDiv y z) q) (Eq h (HMul.hMul p q))))))\n        (Exists fun p =>\n          Exists fun e =>\n            And (Nat.Prime p)\n              (And (LT.lt z p) (And (LE.le p (HDiv.hDiv y z)) (And (LE.le 2 e) (Eq h (HPow.hPow p e))))))))"
    },
    {
      "name": "Erdos1139.Palomar.fixedParameterCoreSquared",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.fixedParameterCoreSquared (y z : Nat) : Finset Nat :=\n  fun y z => Inter.inter (Nat.primesLE z) (Erdos1139.Palomar.fixedParameterCorePrimes y z)"
    },
    {
      "name": "Erdos1139.Palomar.fixedParameterCorePrimes",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.fixedParameterCorePrimes (y z : Nat) : Finset Nat :=\n  fun y z => Nat.primesLE (HDiv.hDiv y z)"
    },
    {
      "name": "Erdos1139.Palomar.deficientTargets",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.deficientTargets (y : Nat) (P squared : Finset Nat) (a : Nat \u2192 Nat) : Finset Nat :=\n  fun y P squared a =>\n  Finset.filter\n    (fun h =>\n      LT.lt\n        (HAdd.hAdd (Finset.card (Finset.filter (fun p => Nat.ModEq p (a p) h) P))\n          (Finset.card (Finset.filter (fun p => Nat.ModEq (HPow.hPow p 2) (a p) h) squared)))\n        2)\n    (Finset.Icc 1 y)"
    },
    {
      "name": "Erdos1139.Palomar.HasSublinearUnrestrictedConductorCovers",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.HasSublinearUnrestrictedConductorCovers : Prop :=\n  \u2200 (\u03b5 : Real),\n  LT.lt 0 \u03b5 \u2192\n    \u2200 (Y\u2080 : Nat),\n      Exists fun y =>\n        Exists fun P =>\n          Exists fun squared =>\n            Exists fun a =>\n              And (LE.le Y\u2080 y)\n                (And (Erdos1139.Palomar.UnrestrictedPrimeSquareDoubleCover y P squared a)\n                  (LE.le (Real.log \u2191(Finset.prod P fun p => Erdos1139.Palomar.selectedPrimePower squared p))\n                    (HMul.hMul \u03b5 \u2191y)))"
    },
    {
      "name": "Erdos1139.Palomar.selectedPrimeExponent",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.selectedPrimeExponent (squared : Finset Nat) (p : Nat) : Nat :=\n  fun squared p => ite (Membership.mem squared p) 2 1"
    },
    {
      "name": "Erdos1139.Palomar.selectedPrimePower",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.selectedPrimePower (squared : Finset Nat) (p : Nat) : Nat :=\n  fun squared p => HPow.hPow p (Erdos1139.Palomar.selectedPrimeExponent squared p)"
    },
    {
      "name": "Erdos1139.Palomar.UnrestrictedPrimeSquareDoubleCover",
      "kind": "def",
      "declaration": "def Erdos1139.Palomar.UnrestrictedPrimeSquareDoubleCover (y : Nat) (P squared : Finset Nat) (a : Nat \u2192 Nat) : Prop :=\n  fun y P squared a =>\n  And (\u2200 (p : Nat), Membership.mem P p \u2192 Nat.Prime p)\n    (And (LE.le squared P)\n      (\u2200 (h : Nat),\n        Membership.mem (Finset.Icc 1 y) h \u2192\n          LE.le 2\n            (HAdd.hAdd (Finset.card (Finset.filter (fun p => Nat.ModEq p (a p) h) P))\n              (Finset.card (Finset.filter (fun p => Nat.ModEq (HPow.hPow p 2) (a p) h) squared)))))"
    },
    {
      "name": "Erdos1139.Palomar.uniform_maximal_gap",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.uniform_maximal_gap :\n  Exists fun c =>\n    And (LT.lt 1 c)\n      (Filter.Eventually\n        (fun X =>\n          Exists fun N =>\n            Exists fun y =>\n              And (LT.lt 0 N)\n                (And (LE.le (HAdd.hAdd N y) X)\n                  (And (LE.le (HMul.hMul c (Real.log \u2191X)) \u2191y)\n                    (\u2200 (h : Nat),\n                      Membership.mem (Finset.Icc 1 y) h \u2192\n                        LE.le 3 (DFunLike.coe ArithmeticFunction.cardFactors (HAdd.hAdd N h))))))\n        Filter.atTop)"
    },
    {
      "name": "Erdos1139.Palomar.limsup_strictly_gt_one",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.limsup_strictly_gt_one :\n  Exists fun A =>\n    And (LT.lt 1 A)\n      (LE.le (Real.toEReal A)\n        (Filter.limsup\n          (fun k =>\n            HDiv.hDiv\n              (HSub.hSub\n                (Real.toEReal\n                  \u2191(Nat.nth (fun n => And (LT.lt 0 n) (LE.le (DFunLike.coe ArithmeticFunction.cardFactors n) 2))\n                      (HAdd.hAdd k 1)))\n                (Real.toEReal\n                  \u2191(Nat.nth (fun n => And (LT.lt 0 n) (LE.le (DFunLike.coe ArithmeticFunction.cardFactors n) 2)) k)))\n              (Real.toEReal (Real.log (HAdd.hAdd (\u2191k) 1))))\n          Filter.atTop))"
    },
    {
      "name": "Erdos1139.Palomar.cover_crt_interval",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.cover_crt_interval {y : Nat} {P squared : Finset Nat} {a : Nat \u2192 Nat}\n  (hcover : Erdos1139.Palomar.UnrestrictedPrimeSquareDoubleCover y P squared a) :\n  Exists fun N =>\n    And (LT.lt (Finset.prod P fun p => Erdos1139.Palomar.selectedPrimePower squared p) N)\n      (And (LE.le N (HMul.hMul 2 (Finset.prod P fun p => Erdos1139.Palomar.selectedPrimePower squared p)))\n        (\u2200 (h : Nat),\n          Membership.mem (Finset.Icc 1 y) h \u2192 LE.le 3 (DFunLike.coe ArithmeticFunction.cardFactors (HAdd.hAdd N h))))"
    },
    {
      "name": "Erdos1139.Palomar.seven_square_crt",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.seven_square_crt :\n  And (LT.lt (HPow.hPow 7 2) 40323)\n    (And (LE.le 40323 (HAdd.hAdd (HPow.hPow 7 2) 44100))\n      (\u2200 (p : Nat),\n        Membership.mem (Insert.insert 2 (Insert.insert 3 (Insert.insert 5 (Singleton.singleton 7)))) p \u2192\n          Dvd.dvd (HPow.hPow p 2) (HAdd.hAdd 40323 (ite (Eq p 2) 1 (ite (Eq p 3) 6 (ite (Eq p 5) 2 4))))))"
    },
    {
      "name": "Erdos1139.Palomar.primorial_log_limit",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.primorial_log_limit :\n  Filter.Tendsto (fun y => HDiv.hDiv (Real.log \u2191(primorial y)) \u2191y) Filter.atTop (nhds 1)"
    },
    {
      "name": "Erdos1139.Palomar.limsup_top_of_sparse",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.limsup_top_of_sparse (hsublinear : Erdos1139.Palomar.HasSublinearUnrestrictedConductorCovers) :\n  Eq\n    (Filter.limsup\n      (fun k =>\n        HDiv.hDiv\n          (HSub.hSub\n            (Real.toEReal\n              \u2191(Nat.nth (fun n => And (LT.lt 0 n) (LE.le (DFunLike.coe ArithmeticFunction.cardFactors n) 2))\n                  (HAdd.hAdd k 1)))\n            (Real.toEReal\n              \u2191(Nat.nth (fun n => And (LT.lt 0 n) (LE.le (DFunLike.coe ArithmeticFunction.cardFactors n) 2)) k)))\n          (Real.toEReal (Real.log (HAdd.hAdd (\u2191k) 1))))\n      Filter.atTop)\n    Top.top"
    },
    {
      "name": "Erdos1139.Palomar.core_classification",
      "kind": "theorem",
      "declaration": "theorem Erdos1139.Palomar.core_classification {y z h : Nat} (parameter_positive : LT.lt 0 z)\n  (square_threshold : LE.le z (HDiv.hDiv y z)) :\n  Iff\n    (Membership.mem\n      (Erdos1139.Palomar.deficientTargets y (Erdos1139.Palomar.fixedParameterCorePrimes y z)\n        (Erdos1139.Palomar.fixedParameterCoreSquared y z) fun x => 0)\n      h)\n    (And (Membership.mem (Finset.Icc 1 y) h) (Erdos1139.Palomar.FixedParameterCoreDeficientType y z h))"
    }
  ],
