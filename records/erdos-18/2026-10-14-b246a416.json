  "core_notation_audit": [
    {
      "name": "Erdos18.practicalH",
      "kind": "def",
      "declaration": "def Erdos18.practicalH (n : Nat) : Nat :=\n  fun n =>\n  Finset.sup (Finset.Icc 1 n) fun m =>\n    InfSet.sInf\n      (Set.ofPred fun k =>\n        Exists fun D =>\n          And (LE.le D (Nat.divisors n)) (And (Eq (Finset.card D) k) (Membership.mem (subsetSums (SetLike.coe D)) m)))"
    },
    {
      "name": "subsetSums",
      "kind": "def",
      "declaration": "def subsetSums.{u_1} {M : Type u_1} [AddCommMonoid M] (A : Set M) : Set M :=\n  fun {M} [AddCommMonoid M] A =>\n  Set.ofPred fun n => Exists fun B => And (LE.le (SetLike.coe B) A) (Eq n (Finset.sum B fun i => i))"
    },
    {
      "name": "Nat.IsPractical",
      "kind": "def",
      "declaration": "def Nat.IsPractical (n : Nat) : Prop :=\n  fun n => \u2200 (m : Nat), LE.le m n \u2192 Membership.mem (subsetSums (SetLike.coe (Nat.divisors n))) m"
    },
    {
      "name": "Erdos18.Palomar.factorial_isPractical",
      "kind": "theorem",
      "declaration": "theorem Erdos18.Palomar.factorial_isPractical (n : Nat) : Nat.IsPractical (Nat.factorial n)"
    },
    {
      "name": "Erdos18.Palomar.erdos_18_upper_bound",
      "kind": "theorem",
      "declaration": "theorem Erdos18.Palomar.erdos_18_upper_bound :\n  Filter.Eventually (fun n => LT.lt (Erdos18.practicalH (Nat.factorial n)) n) Filter.atTop"
    }
  ],
