  "core_notation_audit": [
    {
      "name": "Set.partialDensity",
      "kind": "def",
      "declaration": "def Set.partialDensity.{u_1} {\u03b1 : Type u_1} [Preorder \u03b1] [LocallyFiniteOrderBot \u03b1] (S : Set \u03b1) (A : Set \u03b1 := Set.univ)\n  (b : \u03b1) : Real :=\n  fun {\u03b1} [Preorder \u03b1] [LocallyFiniteOrderBot \u03b1] S A b =>\n  HDiv.hDiv \u2191(Set.ncard (Inter.inter (Inter.inter S A) (Set.Iio b))) \u2191(Set.ncard (Inter.inter A (Set.Iio b)))"
    },
    {
      "name": "Set.lowerDensity",
      "kind": "def",
      "declaration": "def Set.lowerDensity.{u_1} {\u03b1 : Type u_1} [Preorder \u03b1] [LocallyFiniteOrderBot \u03b1] (S : Set \u03b1) (A : Set \u03b1 := Set.univ) : Real :=\n  fun {\u03b1} [Preorder \u03b1] [LocallyFiniteOrderBot \u03b1] S A => Filter.liminf (fun b => Set.partialDensity S A b) Filter.atTop"
    },
    {
      "name": "Erdos968.u",
      "kind": "def",
      "declaration": "def Erdos968.u (n : Nat) : Real :=\n  fun n => HDiv.hDiv (\u2191(Nat.nth Nat.Prime n)) (HAdd.hAdd (\u2191n) 1)"
    },
    {
      "name": "Erdos968.erdos_968.variants.sum_abs_diff_isTheta_log_sq",
      "kind": "theorem",
      "declaration": "theorem Erdos968.erdos_968.variants.sum_abs_diff_isTheta_log_sq :\n  Asymptotics.IsTheta Filter.atTop\n    (fun x =>\n      Finset.sum (Finset.Iio (Nat.primeCounting' x)) fun n =>\n        abs (HSub.hSub (Erdos968.u (HAdd.hAdd n 1)) (Erdos968.u n)))\n    fun x => HPow.hPow (Real.log \u2191x) 2"
    },
    {
      "name": "Erdos968.erdos_968.variants.decreasing_steps_pos_lower_density",
      "kind": "theorem",
      "declaration": "theorem Erdos968.erdos_968.variants.decreasing_steps_pos_lower_density :\n  LT.lt 0 (Set.lowerDensity (Set.ofPred fun n => GT.gt (Erdos968.u n) (Erdos968.u (HAdd.hAdd n 1))))"
    }
  ],
