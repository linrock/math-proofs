  "core_notation_audit": [
    {
      "name": "Erdos10.sumPrimeAndTwoPows",
      "kind": "def",
      "declaration": "def Erdos10.sumPrimeAndTwoPows (k : Nat) : Set Nat :=\n  fun k =>\n  Set.ofPred fun x =>\n    Exists fun p =>\n      Exists fun pows =>\n        Exists fun x_1 =>\n          Exists fun x_2 => Eq (HAdd.hAdd p (Multiset.sum (Multiset.map (fun x => HPow.hPow 2 x) pows))) x"
    },
    {
      "name": "Erdos10.variants.two_mem_zero",
      "kind": "theorem",
      "declaration": "theorem Erdos10.variants.two_mem_zero : Membership.mem (Erdos10.sumPrimeAndTwoPows 0) 2"
    },
    {
      "name": "Erdos10.variants.one_not_mem",
      "kind": "theorem",
      "declaration": "theorem Erdos10.variants.one_not_mem (k : Nat) : Not (Membership.mem (Erdos10.sumPrimeAndTwoPows k) 1)"
    },
    {
      "name": "Erdos10.variants.two_pows",
      "kind": "theorem",
      "declaration": "theorem Erdos10.variants.two_pows : Set.Infinite (SDiff.sdiff (Set.ofPred fun n => Even n) (Erdos10.sumPrimeAndTwoPows 2))"
    },
    {
      "name": "Erdos10.variants.grechuk_example",
      "kind": "theorem",
      "declaration": "theorem Erdos10.variants.grechuk_example : Not (Membership.mem (Erdos10.sumPrimeAndTwoPows 3) 1117175146)"
    },
    {
      "name": "Erdos10.variants.grechuk",
      "kind": "theorem",
      "declaration": "theorem Erdos10.variants.grechuk : Set.Infinite (SDiff.sdiff (Set.ofPred fun n => Even n) (Erdos10.sumPrimeAndTwoPows 3))"
    }
