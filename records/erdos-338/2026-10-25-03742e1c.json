    {
      "name": "Erdos338.HasRestrictedOrder",
      "kind": "def",
      "declaration": "def Erdos338.HasRestrictedOrder (A : Set Nat) (t : Nat) : Prop :=\n  fun A t =>\n  Filter.Eventually\n    (fun m =>\n      Exists fun S =>\n        And (\u2200 (x : Nat), Membership.mem S x \u2192 Membership.mem A x)\n          (And (LE.le (Finset.card S) t) (Eq (Finset.sum S fun x => x) m)))\n    Filter.atTop"
    },
    {
      "name": "Erdos338.restrictedOrder",
      "kind": "def",
      "declaration": "def Erdos338.restrictedOrder (A : Set Nat) : ENat :=\n  fun A => iInf fun t => iInf fun x => \u2191t"
    },
    {
      "name": "Erdos338.HasOrder",
      "kind": "def",
      "declaration": "def Erdos338.HasOrder (A : Set Nat) (h : Nat) : Prop :=\n  fun A h =>\n  Filter.Eventually\n    (fun m =>\n      Exists fun S =>\n        And (\u2200 (x : Nat), Membership.mem S x \u2192 Membership.mem A x)\n          (And (LE.le (Multiset.card S) h) (Eq (Multiset.sum S) m)))\n    Filter.atTop"
    },
    {
      "name": "Erdos338.basisOrder",
      "kind": "def",
      "declaration": "def Erdos338.basisOrder (A : Set Nat) : ENat :=\n  fun A => iInf fun h => iInf fun x => \u2191h"
    },
    {
      "name": "Erdos338.erdos_338.variants.hegyvari_hennecart_plagne",
      "kind": "theorem",
      "declaration": "theorem Erdos338.erdos_338.variants.hegyvari_hennecart_plagne (k : Nat) :\n  LE.le 2 k \u2192\n    Exists fun A =>\n      And (Eq (Erdos338.basisOrder A) \u2191k)\n        (Eq (Erdos338.restrictedOrder A) \u2191(HSub.hSub (HAdd.hAdd (HPow.hPow 2 (HSub.hSub k 2)) k) 1))"
    }
  ],
